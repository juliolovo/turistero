{
  "name": "turistero",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e",
    "meta-app"
  ],
  "scripts": {
    "dev": "npm run dev -w @turistero/web",
    "build": "npm run build -w @turistero/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test scripts/check-secrets.test.mjs",
    "api": "npm run dev -w @turistero/api",
    "db:seed": "npm run seed -w @turistero/db",
    "e2e": "npm run e2e -w @turistero/e2e",
    "db:migrate": "npm run migrate -w @turistero/db",
    "db:generate": "npm run generate -w @turistero/db",
    "meta:check": "npm run check -w @turistero/meta-app --",
    "meta:token": "npm run token -w @turistero/meta-app --",
    "prepare": "node scripts/install-hooks.mjs",
    "secrets:check": "node scripts/check-secrets.mjs --all",
    "secrets:history": "node scripts/check-secrets.mjs --all --history",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:psql": "docker compose exec postgres psql -U postgres -d turistero_db_dev",
    "test:pg": "node scripts/test-postgres.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
