# Copiar a .env.local (web) / entorno de la API. NUNCA commitear secretos reales.

# --- Web (apps/web) ---
API_URL=http://localhost:4000          # sin esto, la web usa datos de ejemplo en memoria
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- API (apps/api) ---
PORT=4000
DATABASE_URL=                          # Postgres, rol de la APLICACION (solo filas). Vacío en dev => PGlite embebido. Local: postgres://turistero_app_usr:turistero_app_pwd@127.0.0.1:5433/turistero_db_dev
DATABASE_ADMIN_URL=                    # rol ADMINISTRADOR (DDL): solo para `npm run db:migrate` / `db:seed` y CI. NUNCA en Vercel
TEST_DATABASE_URL=                     # solo pruebas: superusuario local con CREATEDB (lo arma `npm run test:pg`)
PGLITE_DIR=.pglite                     # persistencia local opcional cuando no hay DATABASE_URL
API_SERVICE_TOKEN=                     # token servidor->servidor (web -> API, cron). Largo y aleatorio; igual en web y API
API_JWT_SECRET=                        # firma JWT de sesión web -> API. Igual en web y API
ADMIN_EMAILS=                          # correos (verificados por Google) que reciben ADMIN, separados por coma
CORS_ORIGINS=http://localhost:3000
ALLOW_DEV_AUTH=0                       # 1 solo en desarrollo: habilita cabecera x-dev-user (id:ROLE)
LOG_LEVEL=info

# --- Web: Auth.js (ver docs/AUTH.md) ---
AUTH_SECRET=                           # openssl rand -base64 32
AUTH_TRUST_HOST=true                   # en Vercel se infiere
ALLOW_DEV_LOGIN=0                      # 1 solo en desarrollo
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=        # por defecto cuentas personales (consumers); o https://login.microsoftonline.com/<TENANT>/v2.0
AUTH_APPLE_ID=                         # Services ID
AUTH_APPLE_SECRET=                     # JWT: node scripts/apple-client-secret.mjs (caduca <= 6 meses)
NEXT_PUBLIC_CONTACT_EMAIL=             # aparece en /privacy y /data-deletion
TOKEN_ENCRYPTION_KEY=                  # Fase 4: cifra tokens OAuth de Meta guardados en BD

# --- Discovery / cron ---
CRON_SECRET=                           # Vercel Cron lo envía como Bearer a /api/cron/discovery
CRON_BUDGET_MS=45000                   # presupuesto de tiempo por ejecución (las siguientes continúan)
ENABLE_LOCAL_CRON=0                    # 1 = planificador en proceso (servidor propio): lun/mié/vie 05:15 America/Managua
META_GRAPH_VERSION=v21.0               # verificar contra la documentación vigente de Meta
META_APP_ID=                            # API (y web si no defines AUTH_FACEBOOK_ID): "Conectar con Meta" y scripts de meta-app/
META_SCOPES=                           # opcional: permisos del botón Conectar con Meta (por defecto pages_show_list,instagram_basic,pages_read_engagement)
META_APP_SECRET=                       # API: verifica los callbacks de Meta (data-deletion, deauthorize)
MIN_RECHECK_HOURS=24                   # una lectura por fuente cada N horas (cortesía)
META_FB_TOKEN=                         # atajo de desarrollo (en producción usa /admin/connections, cifrado en BD)
META_IG_TOKEN=
META_IG_USER_ID=
